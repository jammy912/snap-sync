# build 時由 scripts/build-config.js 產生，不進 git
public/js/config.js

# 本機端點覆寫（開發用，勿提交）
.env
.env.local

# PowerShell 設定：含 ADMIN_TOKEN，絕不可進 git
powershell/config.json

# Vercel
.vercel

# 相依套件（本專案零依賴，保險起見仍列）
node_modules/

# OS / 編輯器
Thumbs.db
desktop.ini
.DS_Store
.vscode/
.idea/

# PowerShell 執行記錄
powershell/logs/
*.log

# 現場標記檔：內容含客戶資料（施工單位、地址），絕不可進 git。
# 正常情況下它位於來源照片目錄，不在本專案內；這裡只是保險。
.snapsync
**/.snapsync
